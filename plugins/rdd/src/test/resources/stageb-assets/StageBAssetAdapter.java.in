package com.dwinovo.numen.plugins.rdd;
import com.dwinovo.numen.rdd.core.*;import com.google.gson.*;import java.util.*;
import java.util.concurrent.*;import java.util.function.*;
final class RddStageBAssetHost {
    record Context(UUID companionId,TaskChain owner,long revision,String catalog){}
    static Context capture(UUID id,TaskChain owner,long revision){return new Context(id,owner,revision,"rdd_assets detail asset_id=base");}
    static boolean current(Context scope){var f=StageBAssetHost.live;return f.current&&f.chain==scope.owner()&&f.chain.planRevision()==scope.revision();}
    static void dispatch(Context scope,Runnable action){StageBAssetHost.live.server.add(()->{if(current(scope))action.run();});}
    static String read(Context scope,JsonObject args){if(!current(scope))return null;var f=StageBAssetHost.live;f.readCount++;return RddAssetReadView.dispatch(args,f.registry);}
    static <T> CompletableFuture<T> send(Context scope,Supplier<CompletableFuture<T>> send){var result=new CompletableFuture<T>();dispatch(scope,()->send.get().whenComplete((value,error)->{if(error!=null)result.completeExceptionally(error);else result.complete(value);}));return result;}
}
