{
  "name": "lure_animals_into_pen",
  "version": "6",
  "description": "拿小麦把附近的【羊】引进圈。只挑羊（不再混进猪/鸡/掉落物）；引三趟；卸麦、数圈内羊、先走出圈外、从外面关好栅栏门；不足 2 只则收尾时报差几只。",
  "tags": ["husbandry", "lure", "pen", "sheep"],
  "planner_notes": "★ v6 相对 v5 的修正（来自 2026-10-09 实机复盘）：① v5 的 type_filter=passive 含猪/鸡/掉落物，'最近的一只'可能根本不是羊 → 每趟用 $filter 只留 entity.minecraft.sheep；② 三趟线性重复（for/while 里塞异步 goto 会续跑重来，不能用循环）；③ 引擎的 $pick=nearest 坐标解析已于 2026-10-09 修好（coords 支持点路径），现在真按距离选；④ scan 半径 16→24（羊常在 20+ 格外）。机制坑仍在：异步步(goto)会 PAUSED 要 resume；步输出不跨暂停保留，只有 set 写的 $var 保留——所以每次 scan 后立刻 set 进 $var。输入：pen_x/y/z、gate_x/y/z、out_x/y/z。",
  "safety_notes": "只走位、换手、右键闸门、只读计数；goto may_alter_terrain=false。",
  "limits": { "max_steps": 120, "max_timeout_ms": 900000 },
  "steps": [
    { "id": "read", "block": "get_self_status", "params": {} },
    { "id": "save0", "block": "set", "params": { "origin": "$read.position" } },
    { "id": "hold", "block": "equip_item", "params": { "action": "equip", "item_id": "minecraft:wheat", "slot": "mainhand", "ignore_failure": true } },

    { "id": "scan1", "block": "scan_nearby_entities", "params": { "radius": 24, "type_filter": "passive" } },
    { "id": "save1", "block": "set", "params": { "e1": "$scan1.entities" } },
    { "id": "approach1", "block": "goto", "params": {
        "x": { "$from": "$var.e1", "$filter": { "field": "type", "op": "==", "value": "entity.minecraft.sheep" }, "$pick": "nearest", "$origin": "$var.origin", "$pick_fields": "position.x,position.y,position.z", "$take": "position.x", "$as": "int" },
        "y": { "$from": "$var.e1", "$filter": { "field": "type", "op": "==", "value": "entity.minecraft.sheep" }, "$pick": "nearest", "$origin": "$var.origin", "$pick_fields": "position.x,position.y,position.z", "$take": "position.y", "$as": "int" },
        "z": { "$from": "$var.e1", "$filter": { "field": "type", "op": "==", "value": "entity.minecraft.sheep" }, "$pick": "nearest", "$origin": "$var.origin", "$pick_fields": "position.x,position.y,position.z", "$take": "position.z", "$as": "int" },
        "may_alter_terrain": false } },
    { "id": "lead1", "block": "goto", "params": { "x": "$input.pen_x", "y": "$input.pen_y", "z": "$input.pen_z", "may_alter_terrain": false } },

    { "id": "scan2", "block": "scan_nearby_entities", "params": { "radius": 24, "type_filter": "passive" } },
    { "id": "save2", "block": "set", "params": { "e2": "$scan2.entities" } },
    { "id": "approach2", "block": "goto", "params": {
        "x": { "$from": "$var.e2", "$filter": { "field": "type", "op": "==", "value": "entity.minecraft.sheep" }, "$pick": "nearest", "$origin": "$var.origin", "$pick_fields": "position.x,position.y,position.z", "$take": "position.x", "$as": "int" },
        "y": { "$from": "$var.e2", "$filter": { "field": "type", "op": "==", "value": "entity.minecraft.sheep" }, "$pick": "nearest", "$origin": "$var.origin", "$pick_fields": "position.x,position.y,position.z", "$take": "position.y", "$as": "int" },
        "z": { "$from": "$var.e2", "$filter": { "field": "type", "op": "==", "value": "entity.minecraft.sheep" }, "$pick": "nearest", "$origin": "$var.origin", "$pick_fields": "position.x,position.y,position.z", "$take": "position.z", "$as": "int" },
        "may_alter_terrain": false } },
    { "id": "lead2", "block": "goto", "params": { "x": "$input.pen_x", "y": "$input.pen_y", "z": "$input.pen_z", "may_alter_terrain": false } },

    { "id": "scan3", "block": "scan_nearby_entities", "params": { "radius": 24, "type_filter": "passive" } },
    { "id": "save3", "block": "set", "params": { "e3": "$scan3.entities" } },
    { "id": "approach3", "block": "goto", "params": {
        "x": { "$from": "$var.e3", "$filter": { "field": "type", "op": "==", "value": "entity.minecraft.sheep" }, "$pick": "nearest", "$origin": "$var.origin", "$pick_fields": "position.x,position.y,position.z", "$take": "position.x", "$as": "int" },
        "y": { "$from": "$var.e3", "$filter": { "field": "type", "op": "==", "value": "entity.minecraft.sheep" }, "$pick": "nearest", "$origin": "$var.origin", "$pick_fields": "position.x,position.y,position.z", "$take": "position.y", "$as": "int" },
        "z": { "$from": "$var.e3", "$filter": { "field": "type", "op": "==", "value": "entity.minecraft.sheep" }, "$pick": "nearest", "$origin": "$var.origin", "$pick_fields": "position.x,position.y,position.z", "$take": "position.z", "$as": "int" },
        "may_alter_terrain": false } },
    { "id": "lead3", "block": "goto", "params": { "x": "$input.pen_x", "y": "$input.pen_y", "z": "$input.pen_z", "may_alter_terrain": false } },

    { "id": "drop", "block": "equip_item", "params": { "action": "unequip", "slot": "mainhand", "ignore_failure": true } },

    { "id": "cnt", "block": "count_entities_in_box", "params": {
        "x1": { "$calc": "$input.pen_x - 2" }, "y1": { "$calc": "$input.pen_y - 1" }, "z1": { "$calc": "$input.pen_z - 2" },
        "x2": { "$calc": "$input.pen_x + 2" }, "y2": { "$calc": "$input.pen_y + 1" }, "z2": { "$calc": "$input.pen_z + 2" },
        "type_id": "minecraft:sheep" } },
    { "id": "saven", "block": "set", "params": { "n": "$cnt.count" } },

    { "id": "leave", "block": "goto", "params": { "x": "$input.out_x", "y": "$input.out_y", "z": "$input.out_z", "may_alter_terrain": false } },

    { "id": "gate", "block": "inspect_block", "params": { "x": "$input.gate_x", "y": "$input.gate_y", "z": "$input.gate_z" } },
    { "id": "saveg", "block": "set", "params": { "gateopen": "$gate.properties.open" } },
    { "id": "close_gate", "block": "if", "params": { "condition": { "field": "$var.gateopen", "op": "==", "value": "true" } }, "children": [
        { "id": "shut", "block": "interact_at", "params": { "button": "right", "x": "$input.gate_x", "y": "$input.gate_y", "z": "$input.gate_z", "ignore_failure": true } }
    ] },

    { "id": "enough", "block": "guard", "params": { "condition": { "field": "$var.n", "op": ">=", "value": 2 }, "message": "圈内只引到 $var.n 只羊（<2）；门已关好，可再引一趟", "on_fail": "fail" } },
    { "id": "done", "block": "get_self_status", "params": {} }
  ]
}
